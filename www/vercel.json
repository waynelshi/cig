{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(curl|wget|httpie|fetch).*"
        }
      ],
      "destination": "/install.sh"
    },
    {
      "source": "/install.sh",
      "destination": "/install.sh"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}